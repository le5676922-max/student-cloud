<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion><parent><groupId>io.studentcloud</groupId><artifactId>student-cloud-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
 <artifactId>cloud-platform-service</artifactId>
 <dependencies>
  <dependency><groupId>io.studentcloud</groupId><artifactId>cloud-service-runtime</artifactId></dependency>
  <dependency><groupId>io.studentcloud</groupId><artifactId>cloud-service-clients</artifactId></dependency>
  <dependency><groupId>io.studentcloud</groupId><artifactId>cloud-account</artifactId></dependency>
  <dependency><groupId>io.studentcloud</groupId><artifactId>cloud-support</artifactId></dependency>
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-websocket</artifactId></dependency>
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-mail</artifactId></dependency>
  <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
  <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
  <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
  <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId></dependency>
 </dependencies>
 <build><plugins>
  <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId>
   <executions><execution><id>platform-service-boundary</id><goals><goal>enforce</goal></goals><configuration><rules><bannedDependencies>
    <excludes><exclude>io.studentcloud:cloud-course</exclude><exclude>io.studentcloud:cloud-drive</exclude><exclude>io.studentcloud:cloud-drive-application</exclude><exclude>io.studentcloud:cloud-assistant</exclude><exclude>io.studentcloud:cloud-tasks</exclude></excludes>
    <includes><include>io.studentcloud:*:*:*:test</include></includes>
    <message>Platform owns identity/support only; other business persistence belongs to its own service.</message>
   </bannedDependencies></rules></configuration></execution></executions>
  </plugin>
 </plugins></build>
</project>
