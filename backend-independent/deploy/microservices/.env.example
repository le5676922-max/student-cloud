# This file is a template. prepare-env.sh creates random secrets in ignored .env.
SC_IMAGE_PREFIX=student-cloud
SC_IMAGE_TAG=0.1.0-SNAPSHOT
SC_ALLOWED_ORIGINS=http://127.0.0.1:18094,http://localhost:18094
SC_NODE_A_IP=172.16.0.10
SC_NODE_B_IP=172.16.0.11
SC_EDGE_SUBNET=172.30.50.0/28
SC_FRONTEND_EDGE_IP=172.30.50.2
SC_HTTPS_EDGE_PROXY_IP=172.30.50.1
SC_INTERNAL_KEY=REPLACE_WITH_64_HEX_CHARACTERS
MYSQL_ROOT_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
SC_PLATFORM_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
SC_CONTENT_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
SC_INTELLIGENCE_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# Redis is an optional infrastructure profile only; business caching is not wired yet.
SC_REDIS_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS

# Content service only. Generate once with: openssl rand -base64 32
# Keep this master key stable: changing it makes existing encrypted OSS/S3 credentials unreadable.
SC_STORAGE_MASTER_KEY=
# Comma-separated exact custom API origins. Empty permits approved public OSS/AWS origins only.
# Production custom endpoints use HTTPS. HTTP is allowed only for explicit loopback test origins.
SC_STORAGE_ALLOWED_ENDPOINTS=

# Optional QQ SMTP: enable only after setting your own mailbox and SMTP authorization code.
SC_MAIL_ENABLED=false
SC_REGISTRATION_ENABLED=true
SC_PASSWORD_RESET_ENABLED=true
SC_SMTP_HOST=smtp.qq.com
SC_SMTP_PORT=465
SC_SMTP_USERNAME=
SC_SMTP_PASSWORD=

# Optional chat provider; private course context requires user consent in the chat UI.
# Set your own API key on the server. Empty key disables model answers; file previews still work.
SC_AI_BASE_URL=https://api.deepseek.com
SC_AI_MODEL=deepseek-flash
SC_AI_API_KEY=
