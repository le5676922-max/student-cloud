FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache curl \
    && addgroup -g 10001 studentcloud \
    && adduser -D -u 10001 -G studentcloud studentcloud
WORKDIR /app
ARG APP_MODULE
COPY --chown=10001:10001 ${APP_MODULE}/target/*-SNAPSHOT.jar /app/app.jar
USER 10001:10001
ENV SC_BIND_ADDRESS=0.0.0.0
ENV SC_HEALTH_PATH=readyz
HEALTHCHECK --interval=20s --timeout=4s --start-period=45s --retries=3 \
  CMD curl --fail --silent --output /dev/null "http://127.0.0.1:${SC_PORT}/${SC_HEALTH_PATH}" || exit 1
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
