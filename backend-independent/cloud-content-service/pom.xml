<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.studentcloud</groupId><artifactId>student-cloud-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>cloud-content-service</artifactId>
  <dependencies>
    <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>3.0.8</version></dependency>
    <dependency><groupId>org.apache.poi</groupId><artifactId>poi-ooxml</artifactId><version>6.0.0</version></dependency>
    <dependency><groupId>io.studentcloud</groupId><artifactId>cloud-common</artifactId></dependency>
    <dependency><groupId>io.studentcloud</groupId><artifactId>cloud-account-api</artifactId></dependency>
    <dependency><groupId>io.studentcloud</groupId><artifactId>cloud-service-runtime</artifactId></dependency>
    <dependency><groupId>io.studentcloud</groupId><artifactId>cloud-service-clients</artifactId></dependency>
    <dependency><groupId>io.studentcloud</groupId><artifactId>cloud-drive-application</artifactId></dependency>
    <dependency><groupId>io.studentcloud</groupId><artifactId>cloud-object-storage</artifactId></dependency>
    <dependency><groupId>io.studentcloud</groupId><artifactId>cloud-course</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId>
      <executions><execution><id>content-service-boundary</id><goals><goal>enforce</goal></goals><configuration><rules><bannedDependencies>
        <excludes><exclude>io.studentcloud:cloud-account</exclude><exclude>io.studentcloud:cloud-assistant</exclude><exclude>io.studentcloud:cloud-support</exclude><exclude>io.studentcloud:cloud-tasks</exclude></excludes>
        <includes><include>io.studentcloud:*:*:*:test</include></includes>
        <message>Content service must use account contracts and remote clients, never platform or intelligence persistence.</message>
      </bannedDependencies></rules></configuration></execution></executions>
    </plugin>
  </plugins></build>
</project>
