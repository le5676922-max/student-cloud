# 示例无真实秘密；复制为 .env.production，权限设为 600，不提交 Git。
# 密码建议使用 openssl rand -hex 24，避免 $、空格、# 的 .env 转义问题。
APP_ORIGIN=http://YOUR_SERVER_IP
WEB_BIND_ADDRESS=0.0.0.0
WEB_HTTP_PORT=80
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
STUDENT_CLOUD_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_APP_PASSWORD
STUDENT_CLOUD_REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_REDIS_PASSWORD
STUDENT_CLOUD_CACHE_NAMESPACE=student-cloud-production

# 本地分片续传临时区总配额20GiB；预留约2倍文件大小，需留足宿主机磁盘。
STUDENT_CLOUD_RESUMABLE_UPLOAD_ENABLED=true
STUDENT_CLOUD_UPLOAD_STAGING_QUOTA_BYTES=21474836480

# QQ 邮箱密码填 SMTP 授权码，不是邮箱网页登录密码。开启前必须填写以下四项。
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_FROM=
MAIL_PASSWORD=
MAIL_CODE_SECRET=

# 可先关闭模型，登录/云盘仍可正常使用。
TLGXY_CLOUD_AI_ENABLED=false
TLGXY_CLOUD_AI_API_KEY=
TLGXY_CLOUD_AI_BASE_URL=https://api.deepseek.com
TLGXY_CLOUD_AI_MODEL=deepseek-flash

# 可选本地 OCR。Docker 镜像包含英文/简体中文引擎；不会将扫描图发给模型。
STUDENT_CLOUD_OCR_ENABLED=false
STUDENT_CLOUD_OCR_LANGUAGE=chi_sim+eng
STUDENT_CLOUD_OCR_MAX_PAGES=10
STUDENT_CLOUD_OCR_DPI=120
STUDENT_CLOUD_OCR_MAX_CHARS=60000
STUDENT_CLOUD_OCR_PAGE_TIMEOUT_SECONDS=15
STUDENT_CLOUD_OCR_TOTAL_TIMEOUT_SECONDS=90

# 可选语义检索。只填写支持标准 /embeddings 的供应商，不能填聊天DeepSeek密钥。
STUDENT_CLOUD_EMBEDDING_ENABLED=false
STUDENT_CLOUD_EMBEDDING_BASE_URL=
STUDENT_CLOUD_EMBEDDING_API_KEY=
STUDENT_CLOUD_EMBEDDING_MODEL=
STUDENT_CLOUD_EMBEDDING_DIMENSIONS=1024
STUDENT_CLOUD_EMBEDDING_MIN_SIMILARITY=0.25
